{
  "model_name": "meta-llama/Llama-3.1-8B::decode",
  "cli": "vllm",
  "env": [
    "UCX_TLS=rc,cuda_ipc,cuda_copy,tcp",
    "UCX_SOCKADDR_TLS_PRIORITY=rdmacm",
    "VLLM_ENABLE_V1_MULTIPROCESSING=1",
    "VLLM_HTTP_TIMEOUT_KEEP_ALIVE=120",
    "VLLM_WORKER_MULTIRPOC_METHOD=spawn",
    "VLLM_KVC_MEM_GB=60",
    "LMCACHE_TRACK_USAGE=false"
  ],
  "args": [
    "serve",
    "/models/meta-llama/Llama-3.1-8B",
    "--load-format",
    "serverless_llm",
    "--served-model-name",
    "meta-llama/Llama-3.1-8B",
    "--max-num-batched-tokens",
    "10240",
    "--max-model-len",
    "10240",
    "--enforce-eager",
    "--no-enable-prefix-caching"
  ],
  "tp_arg": "--tensor-parallel-size",
  "host_arg": "--host",
  "port_arg": "--port",
  "autoscaler_config_path": "autoscale_configs/default_decode_config.json"

}