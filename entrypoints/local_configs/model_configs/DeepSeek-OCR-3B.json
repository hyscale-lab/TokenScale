
{
  "model_name": "deepseek-ai/DeepSeek-OCR",
  "cli": "vllm",
  "env": [
    "VLLM_USE_V1=1",
    "VLLM_ENABLE_V1_MULTIPROCESSING=1",
    "VLLM_HTTP_TIMEOUT_KEEP_ALIVE=120",
    "VLLM_WORKER_MULTIRPOC_METHOD=spawn",
    "VLLM_KVC_MEM_GB=30",
    "LMCACHE_TRACK_USAGE=false"
  ],
  "args": [
    "serve",
    "/models/deepseek-ai/DeepSeek-OCR",
    "--logits_processors",
    "vllm.model_executor.models.deepseek_ocr:NGramPerReqLogitsProcessor",
    "--mm-processor-cache-gb",
    "0",
    "--load-format",
    "serverless_llm",
    "--served-model-name",
    "deepseek-ai/DeepSeek-OCR",
    "--enable-chunked-prefill",
    "--max-num-batched-token",
    "1024",
    "--no-enable-prefix-caching",
    "--enforce-eager"
  ],
  "tp_arg": "--tensor-parallel-size",
  "host_arg": "--host",
  "port_arg": "--port",
  "autoscaler_config_path": "autoscale_configs/default_autoscale_config.json"
}