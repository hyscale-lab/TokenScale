{
  "model_name": "Qwen/Qwen2.5-32B::decode",
  "cli": "vllm",
  "env": [
    "UCX_TLS=rc",
    "UCX_SOCKADDR_TLS_PRIORITY=rdmacm",
    "VLLM_ENABLE_V1_MULTIPROCESSING=1",
    "VLLM_HTTP_TIMEOUT_KEEP_ALIVE=120",
    "VLLM_WORKER_MULTIRPOC_METHOD=spawn",
    "VLLM_KVC_MEM_GB=16",
    "LMCACHE_TRACK_USAGE=false"
  ],
  "args": [
    "serve",
    "/models/Qwen/Qwen2.5-32B",
    "--gpu-memory-utilization",
    "0.1",
    "--load-format",
    "serverless_llm",
    "--served-model-name",
    "Qwen/Qwen2.5-32B",
    "--max-num-batched-tokens",
    "10240",
    "--max-model-len",
    "10240",
    "--max-num-seqs",
    "768",
    "--enforce-eager",
    "--no-enable-prefix-caching"
  ],
  "tp_arg": "--tensor-parallel-size",
  "host_arg": "--host",
  "port_arg": "--port",
  "autoscaler_config_path": "autoscale_configs/rps_decode_config.json"

}