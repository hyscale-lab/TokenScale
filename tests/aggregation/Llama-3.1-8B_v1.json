{
  "model_name": "meta-llama/Llama-3.1-8B",
  "cli": "vllm",
  "env": [
    "VLLM_NO_USAGE_STATS=1"
  ],
  "args": [
    "serve",
    "/models/meta-llama/Llama-3.1-8B",
    "--gpu-memory-utilization",
    "0.9",
    "--load-format",
    "serverless_llm",
    "--served-model-name",
    "meta-llama/Llama-3.1-8B",
    "--enable-chunked-prefill",
    "--max-num-batched-token",
    "1024"
  ],
  "tp_arg": "--tensor-parallel-size",
  "host_arg": "--host",
  "port_arg": "--port",
  "autoscaler_config": {
      "type": "DEFAULT",
      "tp_level": 1,
      "max_request_per_instance": 33,
      "min_instance": 0,
      "max_instance": 1,
      "min_life_time": 0,
      "scale_down_to_zero_grace_period": 30
  }
}