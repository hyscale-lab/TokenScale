{
  "model_name": "meta-llama/Llama-3.1-8B::prefill",
  "cli": "vllm",
  "env": [
    "UCX_TLS=cuda_ipc,cuda_copy,tcp",
    "VLLM_ENABLE_V1_MULTIPROCESSING=1",
    "VLLM_HTTP_TIMEOUT_KEEP_ALIVE=120",
    "VLLM_WORKER_MULTIRPOC_METHOD=spawn"
  ],
  "args": [
    "serve",
    "/models/meta-llama/Llama-3.1-8B",
    "--gpu-memory-utilization",
    "0.9",
    "--load-format",
    "serverless_llm",
    "--served-model-name",
    "meta-llama/Llama-3.1-8B",
    "--max-num-batched-tokens",
    "20480",
    "--max-model-len",
    "20480",
    "--enforce-eager",
    "--no-enable-prefix-caching"
  ],
  "tp_arg": "--tensor-parallel-size",
  "host_arg": "--host",
  "port_arg": "--port",
  "autoscaler_config": {
      "type": "RPS",
      "tp_level": 1,
      "target_rps": 10,
      "min_instance": 1,
      "max_instance": 1,
      "min_life_time": 0,
      "scale_down_to_zero_grace_period": 30
  }
}